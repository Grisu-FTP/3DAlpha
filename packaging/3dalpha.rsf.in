# makerom config template. tools/configure.py substitutes the @...@ fields
# per version; everything else is shared. See docs/build-versions.md.

BasicInfo:
  Title                         : "@APP_TITLE@"
  ProductCode                   : "@PRODUCT_CODE@"
  Logo                          : Homebrew

# No RomFs section: nothing ships inside the title. Game data is compiled in
# and the only user-supplied files (texture packs, sounds) are read from
# sdmc:/alpha -- see docs/assets.md. makerom fails outright on a RootPath
# that does not exist, so this stays absent until there is something to put
# in it (licences.txt is the first candidate).

TitleInfo:
  Category                      : Application
  UniqueId                      : @UNIQUE_ID@

Option:
  UseOnSD                       : true
  FreeProductCode               : true
  MediaFootPadding              : false
  EnableCrypt                   : false
  EnableCompress                : true

AccessControlInfo:
  # Worlds live in sdmc:/alpha, so a CIA build needs direct SD access.
  FileSystemAccess:
    - DirectSdmcWrite

  # DSP memory, 0x1FF00000-0x1FF7FFFF. **A CIA does not get this for free and a
  # 3DSX does**, which is why audio worked under the Homebrew Launcher and a
  # CIA of the same build died on launch: HBL runs us inside a host title whose
  # exheader already carries the mapping, and 3dbrew's memory layout says the
  # region is "access to this is specified by the exheader" and nothing else.
  #
  # ndsp does not probe for it. `ndspInit` loads the firmware, asks the DSP
  # service to convert its DRAM offsets with DSP_ConvertProcessAddressFromDspDram
  # -- which is arithmetic on the service side and succeeds whether or not the
  # caller can reach the result -- and then writes through the returned pointer.
  # Without this line that store is a translation fault, so the graceful
  # "no dspfirm.cdc" path in platform/ctr/audio.cpp never gets a chance to run.
  # See crashlogs/010-cia-dsp-memory-unmapped/.
  #
  # IORegisterMapping rather than MemoryMapping: the DSP writes this region
  # concurrently with the ARM11, so it has to be mapped uncached.
  IORegisterMapping:
    - 1ff00000-1ff7ffff

  # VRAM, 0x1F000000-0x1F5FFFFF, read-only. **The same inheritance as the DSP
  # line above**: a 3DSX reads VRAM because the Homebrew Launcher's host title
  # maps it, and a CIA without this line cannot read it at all. Every library
  # applet launch reads it. Before a keyboard opens, libctru's
  # aptScreenTransfer copies both screens into the applet's capture block,
  # reading `framebuf0` of each as GSP reports it. That address can be in VRAM
  # even though our own framebuffers are linear. Without the mapping, the
  # import-name keyboard died in aptConvertScreenForCapture reading
  # 0x1F4C7800 -- see crashlogs/011-cia-import-world/.
  #
  # Read-only, as in the standard homebrew template. The CPU still must not
  # write VRAM, which gpu_memory.cpp relies on (crashlogs/002).
  MemoryMapping:
    - 1f000000-1f5fffff:r

  IdealProcessor                : 0
  AffinityMask                  : 1
  Priority                      : 16
  MaxCpu                        : 0x9E

  MemoryType                    : Application
  HandleTableSize               : 512

  # New 3DS: extended memory, 804MHz clock, L2 cache, and the free third core
  # for the chunk worker. Also call osSetSpeedupEnable(true) at runtime --
  # recent Luma3DS no longer honours the clock from the exheader alone.
  SystemModeExt                 : 124MB
  CpuSpeed                      : 804MHz
  EnableL2Cache                 : true
  CanAccessCore2                : true

  DisableDebug                  : true
  EnableForceDebug              : false
  CanWriteSharedPage            : false
  CanUsePrivilegedPriority      : false
  CanUseNonAlphabetAndNumber    : false
  PermitMainFunctionArgument    : false
  CanShareDeviceMemory          : false
  RunnableOnSleep               : false
  SpecialMemoryArrange          : false

  CoreVersion                   : 2
  DescVersion                   : 2
  ReleaseKernelMajor            : "02"
  ReleaseKernelMinor            : "33"

  # The kernel checks every SVC against this list and kills the process on one
  # it did not grant, so an exheader without it does not merely warn -- makerom
  # refuses to build. This is the standard homebrew set: everything libctru
  # reaches for at runtime and nothing that creates or inspects other
  # processes. Numbers are the SVC ids from 3dbrew, in decimal.
  SystemCallAccess:
    ArbitrateAddress: 34
    Break: 60
    CancelTimer: 28
    ClearEvent: 25
    ClearTimer: 29
    CloseHandle: 35
    ConnectToPort: 45
    ControlMemory: 1
    CreateAddressArbiter: 33
    CreateEvent: 23
    CreateMemoryBlock: 30
    CreateMutex: 19
    CreateSemaphore: 21
    CreateThread: 8
    CreateTimer: 26
    DuplicateHandle: 39
    ExitProcess: 3
    ExitThread: 9
    GetCurrentProcessorNumber: 17
    GetHandleInfo: 41
    GetProcessId: 53
    GetProcessIdOfThread: 54
    GetProcessIdealProcessor: 6
    GetProcessInfo: 43
    GetResourceLimit: 56
    GetResourceLimitCurrentValues: 58
    GetResourceLimitLimitValues: 57
    GetSystemInfo: 42
    GetSystemTick: 40
    GetThreadContext: 59
    GetThreadId: 55
    GetThreadIdealProcessor: 15
    GetThreadInfo: 44
    GetThreadPriority: 11
    MapMemoryBlock: 31
    OutputDebugString: 61
    QueryMemory: 2
    ReleaseMutex: 20
    ReleaseSemaphore: 22
    ReplyAndReceive: 79
    ReplyAndReceive1: 75
    ReplyAndReceive2: 76
    ReplyAndReceive3: 77
    ReplyAndReceive4: 78
    SendSyncRequest: 50
    SendSyncRequest1: 46
    SendSyncRequest2: 47
    SendSyncRequest3: 48
    SendSyncRequest4: 49
    SetThreadPriority: 12
    SetTimer: 27
    SignalEvent: 24
    SleepThread: 10
    UnmapMemoryBlock: 32
    WaitSynchronization1: 36
    WaitSynchronizationN: 37

  # Same rule for services: a name absent here makes srvGetServiceHandle fail
  # at runtime. ptm:sysm is the one that is easy to miss and specific to this
  # project -- osSetSpeedupEnable() goes through PTMSYSM, so dropping it costs
  # the New 3DS clock silently.
  ServiceAccessControl:
    - APT:U
    - ac:u
    - am:net
    - boss:U
    - cam:u
    - cecd:u
    - cfg:nor
    - cfg:u
    - csnd:SND
    - dsp::DSP
    - frd:u
    - fs:USER
    - gsp::Gpu
    - gsp::Lcd
    - hid:USER
    - http:C
    - ir:USER
    - ir:rst
    - ir:u
    - mic:u
    - ndm:u
    - news:u
    - nwm::UDS
    - ptm:sysm
    - ptm:u
    - pxi:dev
    - soc:U
    - ssl:C
    - y2r:u

SystemControlInfo:
  SaveDataSize                  : 0KB   # worlds live on SD, not in title savedata
  RemasterVersion               : 0
  StackSize                     : 0x40000

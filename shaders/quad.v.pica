; 3DAlpha quad vertex shader -- the geometry-shader path's first half.
;
; One 8-byte vertex per *quad*, against the 60 bytes per quad the 12-byte path
; costs once its four vertices and six indices are counted. See
; docs/3ds-performance.md section 2, and core/mesh/vertex.hpp for what the
; format gives up to get there.
;
;   u8 x, y, z, face      offset 0   the quad's first cell inside the section, and
;                                    which of its six faces this quad is
;   u8 slotX, slotY       offset 4   the cube-atlas slot, already split into column
;                                    and row so the shader does not have to divide
;   u8 light              offset 6   (skyLevel << 4) | blockLevel
;   u8 extent             offset 7   faces merged along e1 and e2, as w + 16*h
;
; **Everything that can be done once per quad is done here rather than in the
; geometry shader**, because the two are not equally cheap: enabling the
; geometry stage costs the vertex stage one of its four shader units, so work
; here is divided by three and work there is not divided at all. The geometry
; shader is left with four adds, four swizzles and four emits -- unchanged by
; greedy meshing, which lives entirely in this file.
;
; The face table is the one non-obvious piece. Each face's four corners are
; base + i*e1 + j*e2 over (i,j) = (0,0), (1,0), (1,1), (0,1); the shader
; transforms the base point and the two edge vectors and lets the geometry
; shader add them, which is exact because a projection is linear. A merged quad
; is the same with the edges lengthened to w*e1 and h*e2. The table is uploaded
; from mesh::kFaceBasis, which is static_asserted to rebuild kFaceCorner and
; kFaceCornerUV -- the same tables the 12-byte path reads -- so the two paths
; cannot disagree about winding or texture orientation.

.constf consts(0.0, 1.0, 3.0, 0.0625)
.alias zeros consts.xxxx
.alias ones  consts.yyyy
.alias three consts.zzzz
.alias div16 consts.wwww   ; one light level, and the extent's h digit

; The cube atlas (core/mesh/cube_atlas.hpp): 8 slots to an edge, and in each
; slot an 8-texel gutter, three copies of the tile and another gutter -- so one
; slot is 1/8 of the texture, one copy 1/32 and a gutter 1/64. The inset is
; kCubeUvInset, an eighth of a texel: 4 of the 16384 units that span the atlas.
; The 12-byte path builds a quad's UVs in the mesher; this path builds them
; here, so it has to arrive at the same numbers or the two formats would texture
; differently -- which is the one thing the static_asserts around kFaceBasis
; exist to prevent.
;
; u's two ends take the gutter and the inset in one constant each, gutter plus
; inset at the near end and gutter less inset at the far one, so the gutter
; costs u nothing. v's inset direction depends on uvSign, so v adds its gutter
; on its own.
.constf cubeconst(0.125, 0.03125, 0.015869140625, 0.015380859375)
.alias div8     cubeconst.xxxx
.alias div32    cubeconst.yyyy
.alias nearU    cubeconst.zzzz   ; gutter + inset
.alias farU     cubeconst.wwww   ; gutter - inset
.constf cubeconst2(0.015625, 0.000244140625, 0.0, 0.0)
.alias gutter   cubeconst2.xxxx
.alias inset    cubeconst2.yyyy

.constf lightconst(16.0, 0.03125, 0.5, 2.5)
.alias mul16    lightconst.xxxx
.alias halftex  lightconst.yyyy   ; 0.5/16: the centre of a lightmap texel
.alias half     lightconst.zzzz
.alias oneface  lightconst.wwww   ; w + h above this is more than one face

.fvec mvp[4]

; Fog in view-space distance, exactly as world.v.pica carries it -- the line in
; x and y, the GL_EXP curve's density * log2(e) in z -- and for the same
; reason: the PICA's own fog unit indexes its LUT by window depth, which is
; 1/d, and the whole ramp lands in the first two entries.
.fvec fogparam

; The seam, as world.v.pica has it: a merged quad grows by
; k = seam.x * max(w, 0) + seam.y blocks on every side, w being the view
; distance. Here w is corner 0's for all four corners -- the geometry shader
; could take each corner's own, but only at four instructions it cannot share
; across units, and the seam.y floor is there for exactly the corners that come
; out short. See core/mesh/vertex.hpp for why it exists at all.
.fvec seam

; Three vec4 per face, 18 in all, indexed by face*3:
;   [0] = (base.x, base.y, base.z, faceShade)
;   [1] = (e1.x,   e1.y,   e1.z,   uvSign)
;   [2] = (e2.x,   e2.y,   e2.z,   0)
.fvec faceBasis[18]

; Outputs. All `dummy`, because these are not going to the rasteriser -- they
; are the geometry shader's six input registers v0..v5, in this order, which is
; what the gsh input stride of 6 means.
.out o_p0  dummy   ; corner 0, in clip space
.out o_d1  dummy   ; the e1 edge, in clip space
.out o_d2  dummy   ; the e2 edge, in clip space
.out o_uv  dummy   ; (u0, v0, u1, v1): the run's two u and two v, ready to pick
.out o_col dummy   ; (face shade, fog at corners 0, 1 and 3)
.out o_lm  dummy   ; (lightmap texel centre, face shade, fog at corner 2)

.alias in_pos v0   ; x, y, z, face
.alias in_tex v1   ; slotX, slotY, light, extent

.entry qmain
.proc qmain
	; a0.x indexes the face's three-entry block. The face arrives as an
	; unsigned byte converted to float, so it is exactly 0..5 and mova needs
	; no rounding help.
	mul r0.x, three, in_pos.w
	mova a0.x, r0.x

	; The two unpacks sit here, between the mova and the first indexed read,
	; and not because they belong here.
	;
	; **Whether a0 can be read in the instruction straight after a mova is not
	; something this project has established, and picasso supplies no delay**:
	; the assembled vertex shader is exactly the instructions this file writes,
	; counted out of the shbin, so nothing is being inserted on our behalf. The
	; one devkitPro example that indexes uniforms happens to have four
	; instructions in between. Ten unrelated ones cost nothing here and settle
	; the question by not asking it.
	;
	; Unpacking (sky << 4) | block: there are no integer ops in the PICA vertex
	; ISA, so the nibble split is a divide, a floor and a subtract -- once per
	; quad here, against once per vertex in world.v.pica.
	mul r9.x, div16, in_tex.z
	flr r9.y, r9.x                ; sky   = floor(light / 16)
	mul r9.z, mul16, r9.y
	add r9.x, in_tex.z, -r9.z     ; block = light - sky * 16
	mul r10.xy, div16, r9.xy      ; (block, sky) / 16
	add o_lm.xy, halftex, r10.xy  ; texel centres, so nearest filtering cannot
	                              ; pick up a neighbouring level

	; The extent, w + 16*h, by the same divide, floor and subtract.
	mul r11.x, div16, in_tex.w
	flr r11.y, r11.x              ; h
	mul r11.z, mul16, r11.y
	add r11.x, in_tex.w, -r11.z   ; w

	; Corner 0 = the first cell plus the face's base offset. Positions are
	; section-local, 0..16 in blocks; the section's world origin is in mvp.
	; The uniform goes first: the PICA lets src1 be a uniform and src2 not, so
	; an operand order that reads naturally does not assemble.
	add r1.xyz, faceBasis[a0.x], in_pos
	mov r1.w, ones

	dp4 r5.x, mvp[0], r1
	dp4 r5.y, mvp[1], r1
	dp4 r5.z, mvp[2], r1
	dp4 r5.w, mvp[3], r1

	; The two unit edges, as direction vectors -- w = 0, so the matrix's
	; translation column does not contribute and adding them to a transformed
	; point is the same as transforming the sum.
	mov r2.xyz, faceBasis[a0.x + 1]
	mov r2.w,   zeros
	dp4 r6.x, mvp[0], r2
	dp4 r6.y, mvp[1], r2
	dp4 r6.z, mvp[2], r2
	dp4 r6.w, mvp[3], r2

	mov r3.xyz, faceBasis[a0.x + 2]
	mov r3.w,   zeros
	dp4 r7.x, mvp[0], r3
	dp4 r7.y, mvp[1], r3
	dp4 r7.z, mvp[2], r3
	dp4 r7.w, mvp[3], r3

	; The seam. k is zero unless more than one face was merged -- slt gives 1
	; for 2.5 < w + h -- so a single face comes out exactly as it did before
	; greedy meshing. Then corner 0 moves back by k along both edges and each
	; edge grows by 2k, which moves every corner outward by k along both.
	add r8.x, r11.x, r11.y
	slt r8.x, oneface, r8.x       ; merged: 1 or 0
	max r8.y, zeros, r5.w         ; corner 0's distance, never negative: behind
	mul r8.y, seam.x, r8.y        ; the camera it would shrink the quad
	add r8.y, seam.y, r8.y        ; k for corner 0's distance
	mul r8.x, r8.x, r8.y          ; k, or zero

	add r12, r6, r7
	mul r12, r8.xxxx, r12
	add o_p0, r5, -r12            ; corner 0 - k*(e1 + e2)

	add r8.z, r8.x, r8.x          ; 2k
	add r13.x, r11.x, r8.z        ; w + 2k
	add r13.y, r11.y, r8.z        ; h + 2k
	mul o_d1, r13.xxxx, r6
	mul o_d2, r13.yyyy, r7

	; The run's four texture coordinates, packed so the geometry shader picks
	; each corner's pair with a swizzle instead of an add: corner (i,j) is
	; (u0 or u1, v0 or v1). Neither the lengthened edges nor the seam touch
	; them -- the seam's growth is a fraction of a pixel, and it shows the
	; texel at the edge, which is the one that belongs there.
	;
	; u is i*w copies past the gutter for every face. v is j*h copies for the bottom face and
	; (1-j)*h for the other five, which is the one number uvSign carries: the
	; v of corner j is ((1 - uvSign)/2 + j*uvSign) * h copies. terrain.png's
	; first row being its top is the whole reason five faces differ from one.
	mul r4.x, div8, in_tex.x      ; slotX / 8
	mul r14.x, div32, r11.x       ; w copies
	add r4.z, r4.x, r14.x         ; ... + w copies
	add r4.x, nearU, r4.x         ; u0: past the gutter, in off the run's start
	add r4.z, farU, r4.z          ; u1: past the gutter, in off the run's end

	mov r15.x, faceBasis[a0.x + 1].wwww  ; uvSign, +1 or -1
	add r15.y, ones, -r15.x
	mul r15.y, half, r15.y        ; (1 - uvSign)/2, i.e. 0 or 1
	mul r14.y, div32, r11.y       ; h copies
	mul r15.z, r15.y, r14.y       ; (1 - uvSign)/2 * h copies
	mul r4.y, div8, in_tex.y      ; slotY / 8
	add r4.y, gutter, r4.y        ; past the gutter
	add r4.y, r4.y, r15.z         ; v0
	mul r15.w, r15.x, r14.y
	add r4.w, r4.y, r15.w         ; v1 = v0 + uvSign * h copies

	; v runs the other way for the bottom face, so the inset has to follow
	; uvSign: v0 moves by +uvSign*inset and v1 by -uvSign*inset, which brings
	; them together whichever way round they are.
	mul r14.z, inset, r15.x
	add r4.y, r14.z, r4.y
	add r4.w, r4.w, -r14.z
	mov o_uv, r4

	; **Fog, per corner.** It goes in the colour's alpha, because primary colour
	; is the only per-vertex value a texenv stage can read, and each corner's w
	; is -z_view, which is what fog is defined against. It used to be corner
	; 0's alone for the whole quad -- fine for a line a hundred blocks long, and
	; not for the GL_EXP curve under water, which goes from clear to 0.8 across
	; one sixteen-block quad: a sea floor came out in squares.
	;
	; The corners' w, as the geometry shader will build them: c0 is o_p0's,
	; and the edges add o_d1.w and o_d2.w. r10 = (c0, c1, c2, c3).
	add r10.x, r5.w, -r12.w       ; c0 = corner 0 after the seam
	mul r11.z, r13.x, r6.w        ; o_d1.w
	mul r11.w, r13.y, r7.w        ; o_d2.w
	add r10.y, r10.x, r11.z       ; c1 = c0 + d1
	add r10.w, r10.x, r11.w       ; c3 = c0 + d2
	add r10.z, r10.y, r11.w       ; c2 = c0 + d1 + d2

	; world.v.pica's two terms, four lanes at once: the line d * x + y, and
	; GL_EXP's 1 - 2^(-d * z) beside it. z is zero above water, where the curve
	; is 1 - 1 = 0 and the max leaves the line alone; under water and in lava
	; the line is zeroed instead. ex2 is scalar, hence four of it.
	mul r9, fogparam.xxxx, r10
	add r9, fogparam.yyyy, r9
	mul r14, fogparam.zzzz, r10
	ex2 r15.x, -r14.x
	ex2 r15.y, -r14.y
	ex2 r15.z, -r14.z
	ex2 r15.w, -r14.w
	add r15, ones, -r15
	max r9, r9, r15
	max r9, zeros, r9
	min r9, ones, r9

	; Face shade, from the table rather than from the vertex: this format has no
	; room for per-quad colour, which is exact for a1.1.2 -- its
	; Block.colorMultiplier is white for every block in the game -- and is the
	; reason a version with biome tint cannot use this path.
	;
	; **Packed so the geometry shader still spends one mov a corner on colour.**
	; o_col = (shade, f0, f1, f3) and o_lm = (lm.x, lm.y, shade, f2), so each
	; corner's colour is one swizzle of one input: v4.xxxy, v4.xxxz, v4.xxxw,
	; and v5.zzzw for corner 2. See quad.g.pica.
	mov r8.x, faceBasis[a0.x].w
	mov o_col.x, r8.x
	mov o_col.y, r9.x
	mov o_col.z, r9.y
	mov o_col.w, r9.w
	mov o_lm.z, r8.x
	mov o_lm.w, r9.z

	end
.end

; 3DAlpha world vertex shader.
;
; Vertex is 12 bytes, laid out to match the attribute loader order exactly
; (citro3d derives offsets by accumulating sizes, so field order IS the layout):
;
;   s16 u, v         offset 0   atlas coords, 1/16384 units
;   u8  x, y, z, n   offset 4   position within a 16^3 section (0..16), face index
;   u8  r, g, b, l   offset 8   static colour (face shade x AO), packed light
;
; Two things make the size 12 rather than 11. The GPU fetches the s16 pair from
; an address that must stay 2-byte aligned, and an 11-byte stride would put every
; odd vertex on an odd address. The spare byte in the position attribute is the
; face index, which the geometry-shader path will need.
;
; The packed light byte is (skyLevel << 4) | blockLevel, unpacked here into a
; lightmap texture coordinate. This is what makes day/night free: dusk rewrites
; a 16x16 texture instead of re-meshing the world, which a 268 MHz ARM11 cannot
; do. Baking light into the vertex colour instead would invalidate every mesh
; every time the sun moves.
;
; PICA byte/short attributes arrive as raw values converted to float -- they are
; NOT normalised -- so the scaling happens here.

.constf consts(0.0, 1.0, 0.00006103515625, 0.00392156862745)
.alias zeros    consts.xxxx
.alias ones     consts.yyyy
.alias div16384 consts.zzzz   ; UV scale:     1/16384
.alias div255   consts.wwww   ; colour scale: 1/255

; 1/16 to scale a 0..15 light level into UV, and 0.5/16 to land on a texel
; centre so nearest filtering cannot pick up a neighbour.
.constf lightconst(0.0625, 16.0, 0.03125, 0.0)
.alias div16   lightconst.xxxx
.alias mul16   lightconst.yyyy
.alias halftex lightconst.zzzz

.fvec mvp[4]

; Linear fog, as a line in view-space distance: amount = clamp(d*x + y, 0, 1).
;
; This is here rather than in the PICA's own fog unit because that unit reads a
; 128-entry LUT indexed by **window depth**, and window depth is 1/d. With a
; 0.2-block near plane and a 176-block far plane the entire 40-to-160-block fog
; ramp lands inside the first of those 128 entries, so the hardware fog was a
; single linear interpolation from "clear at 20 blocks" to "solid at the far
; plane" -- far thicker than a1.1.2's, and thicker the further you can see.
;
; out_pos.w is the distance the fog wants: citro3d's perspective matrices all
; write M[3][2] = -1 (checked in the disassembly of Mtx_PerspStereoTilt), so w
; is -z_view, which is what GL_LINEAR fog is defined against. Interpolating the
; result per-vertex is exact for a quad one block across.
.fvec fogparam

.out out_pos position
.out out_uv  texcoord0
.out out_lm  texcoord1
.out out_col color

.alias in_uv  v0
.alias in_xyz v1
.alias in_rgb v2

.entry vmain
.proc vmain
	mov r0.xyz, in_xyz
	mov r0.w,   ones

	dp4 out_pos.x, mvp[0], r0
	dp4 out_pos.y, mvp[1], r0
	dp4 out_pos.z, mvp[2], r0
	dp4 r3.w,      mvp[3], r0
	mov out_pos.w, r3.w

	mul out_uv, div16384, in_uv.xy

	mul out_col.xyz, div255, in_rgb

	; The vertex colour's alpha is the fog amount, which is what carries it to
	; the texenv: primary colour is the only per-vertex value a combiner stage
	; can read, and the three colour bytes are already spoken for by face shade.
	; Nothing sampled the alpha before -- it was a constant 1.0 -- so the cost is
	; that stage 0 must stop modulating alpha, which renderer.cpp does.
	mul r3.x, fogparam.x, r3.w
	add r3.x, fogparam.y, r3.x
	max r3.x, zeros, r3.x
	min out_col.w, ones, r3.x

	; Unpack (sky << 4) | block. There are no integer ops in the PICA vertex
	; ISA, so the nibble split is a divide, a floor, and a subtract.
	mul r1.x, div16, in_rgb.w     ; light / 16
	flr r1.y, r1.x                ; sky   = floor(light / 16)
	mul r1.z, mul16, r1.y         ; sky * 16
	add r1.w, in_rgb.w, -r1.z     ; block = light - sky * 16

	; Texel centres: u = (block + 0.5)/16, v = (sky + 0.5)/16
	mul r2.x, div16, r1.w
	mul r2.y, div16, r1.y
	add out_lm.xy, halftex, r2.xy
	mov out_lm.zw, zeros

	end
.end
